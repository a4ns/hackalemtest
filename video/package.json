{
  "name": "hackalem-intro-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.143 preview",
    "check": "npx --yes hyperframes@0.8.143 check",
    "render": "npx --yes hyperframes@0.8.143 render",
    "cues": "node scripts/build-cues.mjs && node scripts/build-events.mjs",
    "audio": "python3 audio/build_audio.py",
    "snap": "node scripts/snap.mjs",
    "render:final": "npx --yes hyperframes@0.8.143 render --quality delivery --output renders/hackalem-intro.mp4",
    "render:silent": "ffmpeg -y -v error -i renders/hackalem-intro.mp4 -an -c:v copy -movflags +faststart renders/hackalem-intro-silent.mp4",
    "publish": "npx --yes hyperframes@0.8.143 publish"
  }
}
